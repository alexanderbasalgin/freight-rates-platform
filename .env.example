# Скопируйте в .env и при необходимости измените. Без .env используются значения по умолчанию из docker-compose.yml.

# Источник (операционная БД deals_bigdata)
SOURCE_DB_NAME=deals_bigdata
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=change_me_source
N_PRICES=300000

# DWH (raw -> core -> mart)
DWH_DB_NAME=dwh
DWH_DB_USER=postgres
DWH_DB_PASSWORD=change_me_dwh
DWH_HOST_BIND=127.0.0.1
DWH_HOST_PORT=5433

# Пайплайн
AS_OF=2026-10-26
ETL_START_DATE=2023-01-01
ETL_END_DATE=2027-12-31
RANDOM_SEED=42
RUN_TESTS=1
LOG_LEVEL=INFO
